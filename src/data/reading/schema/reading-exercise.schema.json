{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.idiomaswl.com/schemas/reading-exercise.schema.json",
  "title": "WeLearn Reading Exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "language",
    "variant",
    "tutorLocales",
    "level",
    "slug",
    "classification",
    "content",
    "leveling",
    "questions",
    "production",
    "review",
    "seo"
  ],
  "properties": {
    "schemaVersion": {"enum": ["1.0.0", "1.1.0"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,80}$"},
    "status": {"enum": ["draft", "review", "approved", "published", "retired"]},
    "language": {
      "enum": ["en", "fr", "it", "de", "ru", "ja", "ko", "pt"]
    },
    "variant": {
      "type": "string",
      "enum": ["en-global", "en-US", "en-GB", "fr-global", "fr-FR", "fr-CA", "it-IT", "de-DE", "de-AT", "de-CH", "ru", "ja-JP", "ko-KR", "pt-BR"]
    },
    "tutorLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["es", "en"]}
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cefr", "displayLabel"],
      "properties": {
        "cefr": {"enum": ["A0", "A1", "A2", "B1", "B2", "C1"]},
        "displayLabel": {"type": "string", "minLength": 1, "maxLength": 40},
        "jlpt": {"enum": ["N5", "N4", "N3", "N2", "N1"]},
        "topik": {"type": "integer", "minimum": 1, "maximum": 6},
        "examFramework": {"type": "string", "maxLength": 40},
        "examLevel": {"type": "string", "maxLength": 40},
        "mappingDisclaimer": {"$ref": "#/$defs/localizedText"}
      }
    },
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "series": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "episode", "totalEpisodes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "episode": {"type": "integer", "minimum": 1},
        "totalEpisodes": {"type": "integer", "minimum": 2, "maximum": 20},
        "previousExerciseId": {"type": ["string", "null"]},
        "nextExerciseId": {"type": ["string", "null"]}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genre", "topic", "intent"],
      "properties": {
        "genre": {"enum": ["story", "dialogue", "message", "email", "notice", "menu", "schedule", "form", "review", "news-adapted", "article", "instructions", "exam"]},
        "topic": {"type": "string", "minLength": 2, "maxLength": 60},
        "intent": {"enum": ["daily-life", "culture", "travel", "study", "work", "migration", "exam"]},
        "tags": {"type": "array", "uniqueItems": true, "maxItems": 12, "items": {"type": "string", "maxLength": 40}}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "intro", "mission", "targetText", "wordCount", "estimatedMinutes", "vocabulary", "objectives"],
      "properties": {
        "title": {"$ref": "#/$defs/localizedText"},
        "intro": {"$ref": "#/$defs/localizedText"},
        "mission": {"$ref": "#/$defs/localizedText"},
        "targetText": {"type": "string", "minLength": 20, "maxLength": 9000},
        "plainTextForAnalysis": {"type": "string", "minLength": 20, "maxLength": 9000},
        "wordCount": {"type": "integer", "minimum": 1, "maximum": 1500},
        "estimatedMinutes": {"type": "integer", "minimum": 1, "maximum": 30},
        "objectives": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/localizedText"}},
        "grammarFocus": {"type": "array", "uniqueItems": true, "maxItems": 8, "items": {"type": "string", "maxLength": 80}},
        "vocabulary": {
          "type": "array",
          "minItems": 3,
          "maxItems": 18,
          "items": {"$ref": "#/$defs/vocabularyItem"}
        },
        "culturalNote": {"$ref": "#/$defs/localizedText"},
        "spanishSpeakerNote": {"$ref": "#/$defs/localizedText"},
        "sources": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "audio": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["src", "speakerVariant", "transcriptMatchesText"],
      "properties": {
        "src": {"type": "string", "minLength": 1},
        "speakerVariant": {"type": "string", "maxLength": 40},
        "transcriptMatchesText": {"const": true},
        "defaultRate": {"type": "number", "minimum": 0.5, "maximum": 1.25}
      }
    },
    "scriptSupport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "furigana": {"type": "boolean"},
        "romanization": {"enum": ["none", "optional", "a0-only"]},
        "stressMarks": {"type": "boolean"},
        "tokenizationMode": {"enum": ["space", "morphological", "custom"]}
      }
    },
    "leveling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetCanDo", "allowedGrammar", "maxOutOfLevelVocabularyPercent", "inferenceBand", "metrics", "independentAssessment"],
      "properties": {
        "targetCanDo": {"$ref": "#/$defs/localizedText"},
        "allowedGrammar": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 100}},
        "disallowedGrammar": {"type": "array", "items": {"type": "string", "maxLength": 100}},
        "maxOutOfLevelVocabularyPercent": {"type": "number", "minimum": 0, "maximum": 20},
        "inferenceBand": {"enum": ["none", "minimal", "light", "moderate", "high"]},
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["averageSentenceWords", "maxSentenceWords", "outOfLevelVocabularyPercent"],
          "properties": {
            "averageSentenceWords": {"type": "number", "minimum": 1, "maximum": 60},
            "maxSentenceWords": {"type": "integer", "minimum": 1, "maximum": 120},
            "outOfLevelVocabularyPercent": {"type": "number", "minimum": 0, "maximum": 100},
            "glossedOutOfLevelItems": {"type": "integer", "minimum": 0}
          }
        },
        "independentAssessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["estimatedLevel", "passed", "assessedAt"],
          "properties": {
            "estimatedLevel": {"enum": ["A0", "A1", "A2", "B1", "B2", "C1"]},
            "passed": {"type": "boolean"},
            "assessor": {"type": "string", "maxLength": 100},
            "assessedAt": {"type": "string", "format": "date-time"},
            "notes": {"type": "string", "maxLength": 1000}
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/question"}
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "minWords", "maxWords", "hints", "scored"],
      "properties": {
        "prompt": {"$ref": "#/$defs/localizedText"},
        "minWords": {"type": "integer", "minimum": 0, "maximum": 500},
        "maxWords": {"type": "integer", "minimum": 1, "maximum": 1000},
        "hints": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 100}},
        "scored": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "languageReviewer", "pedagogyReviewer", "reviewedAt", "copyrightChecked", "cultureChecked", "languageDecision", "pedagogyDecision"],
      "properties": {
        "author": {"type": "string", "minLength": 2, "maxLength": 120},
        "languageReviewer": {"type": "string", "minLength": 2, "maxLength": 120},
        "pedagogyReviewer": {"type": "string", "minLength": 2, "maxLength": 120},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "copyrightChecked": {"const": true},
        "cultureChecked": {"const": true},
        "aiAssisted": {"type": "boolean"},
        "aiUseNote": {"type": "string", "maxLength": 500},
        "languageDecision": {"enum": ["pending", "changes-requested", "approved"]},
        "pedagogyDecision": {"enum": ["pending", "changes-requested", "approved"]},
        "reviewNotes": {"$ref": "#/$defs/localizedText"}
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "canonicalPath", "indexable", "lastModified"],
      "properties": {
        "title": {"$ref": "#/$defs/localizedText"},
        "description": {"$ref": "#/$defs/localizedText"},
        "canonicalPath": {"type": "string", "pattern": "^/"},
        "indexable": {"type": "boolean"},
        "lastModified": {"type": "string", "format": "date-time"},
        "relatedExerciseIds": {"type": "array", "maxItems": 8, "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"language": {"const": "ja"}}, "required": ["language"]},
      "then": {"properties": {"level": {"required": ["jlpt", "mappingDisclaimer"]}, "scriptSupport": {"required": ["furigana", "romanization", "tokenizationMode"]}}, "required": ["scriptSupport"]}
    },
    {
      "if": {"properties": {"language": {"const": "ko"}}, "required": ["language"]},
      "then": {"properties": {"level": {"required": ["topik", "mappingDisclaimer"]}, "scriptSupport": {"required": ["romanization", "tokenizationMode"]}}, "required": ["scriptSupport"]}
    },
    {
      "if": {"properties": {"language": {"const": "pt"}}, "required": ["language"]},
      "then": {"properties": {"variant": {"const": "pt-BR"}}}
    }
  ],
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "es": {"type": "string", "minLength": 1, "maxLength": 1000},
        "en": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "vocabularyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "lemma", "glosses", "audioRequired"],
      "properties": {
        "surface": {"type": "string", "minLength": 1, "maxLength": 100},
        "lemma": {"type": "string", "minLength": 1, "maxLength": 100},
        "reading": {"type": "string", "maxLength": 100},
        "glosses": {"$ref": "#/$defs/localizedText"},
        "audioRequired": {"type": "boolean"},
        "levelStatus": {"enum": ["within-level", "out-of-level-glossed"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {"type": "string", "minLength": 2, "maxLength": 160},
        "url": {"type": "string", "format": "uri"},
        "accessedAt": {"type": "string", "format": "date-time"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "skill", "prompt", "answer", "feedback", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "type": {"enum": ["single-choice", "multiple-choice", "true-false", "true-false-not-given", "matching", "ordering", "gap-fill", "select-in-text", "short-answer", "main-idea", "detail", "inference", "reference", "purpose", "tone", "vocabulary-in-context"]},
        "skill": {"enum": ["global", "detail", "vocabulary", "inference", "organization", "reference", "purpose", "tone"]},
        "prompt": {"type": "string", "minLength": 3, "maxLength": 700},
        "options": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"$ref": "#/$defs/option"}},
        "answer": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "boolean"},
            {"type": "array", "minItems": 1, "items": {"type": "string"}},
            {"type": "object"}
          ]
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["correct", "incorrect", "strategy"],
          "properties": {
            "correct": {"$ref": "#/$defs/localizedText"},
            "incorrect": {"$ref": "#/$defs/localizedText"},
            "strategy": {"$ref": "#/$defs/localizedText"},
            "distractorNotes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/localizedText"}}
          }
        },
        "evidence": {"type": "string", "minLength": 1, "maxLength": 500},
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}

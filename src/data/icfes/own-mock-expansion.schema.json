{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.idiomaswl.com/schemas/icfes-own-mock-expansion-v2.json",
  "title": "ICFES own-mock expansion manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "productId", "policy", "mocks", "candidates"],
  "properties": {
    "$schema": { "const": "./own-mock-expansion.schema.json" },
    "schemaVersion": { "const": 2 },
    "productId": { "const": "icfes-saber-11-english" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionCount", "parts", "provenanceKind", "allowedEditorialStates", "allowedReleaseStates", "requiredQualityGates"],
      "properties": {
        "questionCount": { "const": 45 },
        "parts": { "const": [1, 2, 3, 4, 5, 6, 7] },
        "provenanceKind": { "const": "welearn-original" },
        "allowedEditorialStates": { "const": ["draft", "in-review", "approved", "rejected", "release-candidate", "published"] },
        "allowedReleaseStates": { "const": ["draft", "approved", "rejected", "release-candidate", "published"] },
        "requiredQualityGates": { "const": ["schema-and-manifest", "stable-unique-ids", "catalog-and-registry-parity", "question-and-part-counts", "answer-index-range", "exact-content-duplicates", "approved-content-hash", "public-answer-leakage"] }
      }
    },
    "mocks": { "type": "array", "minItems": 23, "items": { "$ref": "#/definitions/baselineMock" } },
    "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/candidate" } }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mockId": { "type": "string", "pattern": "^mock-(?:0[1-9]|[1-9][0-9]+)$" },
    "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "baselineMock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mockId", "modulePath", "route", "contentVersion", "contentHash", "provenance", "editorial", "releaseStatus"],
      "properties": {
        "mockId": { "$ref": "#/definitions/mockId" },
        "modulePath": { "type": "string", "pattern": "^src/data/mocks/icfes-mock-(?:0[1-9]|[1-9][0-9]+)\\.ts$" },
        "route": { "type": "string", "pattern": "^/examenes/icfes/practica/mock-(?:0[1-9]|[1-9][0-9]+)$" },
        "contentVersion": { "$ref": "#/definitions/version" },
        "contentHash": { "$ref": "#/definitions/hash" },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "owner", "rights", "authoringRecord"],
          "properties": {
            "kind": { "const": "welearn-original" }, "owner": { "const": "Idiomas WeLearn" },
            "rights": { "const": "owned-content" }, "authoringRecord": { "type": "string", "minLength": 1 }
          }
        },
        "editorial": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reviewedAt", "reviewerRoles", "remediationRecord"],
          "properties": {
            "status": { "const": "approved" }, "reviewedAt": { "type": "string", "format": "date" },
            "reviewerRoles": { "const": ["english-language-specialist", "icfes-format-reviewer", "editorial-adjudicator"] },
            "remediationRecord": { "type": "string", "minLength": 1 }
          }
        },
        "releaseStatus": { "enum": ["release-candidate", "published"] }
      }
    },
    "itemEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["itemId", "authorshipEvidence", "factSources"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "authorshipEvidence": { "type": "string", "minLength": 1 },
        "factSources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["questionId", "severity", "blockProduction", "evidence"],
      "properties": {
        "questionId": { "type": ["string", "null"] }, "severity": { "enum": ["critical", "high", "medium", "low"] },
        "blockProduction": { "type": "boolean" }, "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "reviewReport": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "actorId", "verdict", "candidateDigest", "findings"],
      "properties": {
        "role": { "enum": ["english-language-specialist", "icfes-format-reviewer", "editorial-adjudicator"] },
        "actorId": { "type": "string", "minLength": 2 }, "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "candidateDigest": { "$ref": "#/definitions/hash" },
        "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } }
      }
    },
    "adjudication": {
      "type": "object", "additionalProperties": false,
      "required": ["actorId", "actorType", "decision", "candidateDigest", "evidence"],
      "properties": {
        "actorId": { "type": "string", "minLength": 2 }, "actorType": { "const": "human" },
        "decision": { "enum": ["APPROVE", "REJECT"] }, "candidateDigest": { "$ref": "#/definitions/hash" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "deploymentEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["commitSha", "deploymentId", "environment", "deployedAt", "smokeReport"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" }, "deploymentId": { "type": "string", "minLength": 1 },
        "environment": { "const": "production" }, "deployedAt": { "type": "string", "format": "date-time" },
        "smokeReport": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "mockId", "modulePath", "route", "contentVersion", "contentHash", "candidateDigest", "provenance", "editorial", "release"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^mock-[0-9]+-v[1-9][0-9]*$" },
        "mockId": { "$ref": "#/definitions/mockId" },
        "modulePath": { "type": "string", "pattern": "^src/data/mocks/icfes-mock-(?:0[1-9]|[1-9][0-9]+)\\.ts$" },
        "route": { "type": "string", "pattern": "^/examenes/icfes/practica/mock-(?:0[1-9]|[1-9][0-9]+)$" },
        "contentVersion": { "anyOf": [{ "$ref": "#/definitions/version" }, { "type": "null" }] },
        "contentHash": { "anyOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }] },
        "candidateDigest": { "$ref": "#/definitions/hash" },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "kind", "owner", "rights", "authoringRecord", "itemEvidence"],
          "properties": {
            "status": { "enum": ["pending", "verified"] }, "kind": { "const": "welearn-original" },
            "owner": { "const": "Idiomas WeLearn" }, "rights": { "enum": ["pending", "owned-content"] },
            "authoringRecord": { "type": ["string", "null"] },
            "itemEvidence": { "type": "array", "maxItems": 45, "items": { "$ref": "#/definitions/itemEvidence" } }
          }
        },
        "editorial": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reviewReports", "adjudication"],
          "properties": {
            "status": { "enum": ["draft", "in-review", "approved", "rejected", "release-candidate", "published"] },
            "reviewReports": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/reviewReport" } },
            "adjudication": { "anyOf": [{ "$ref": "#/definitions/adjudication" }, { "type": "null" }] }
          }
        },
        "release": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "catalogEligible", "indexEligible", "premiumEligible", "deploymentEvidence"],
          "properties": {
            "status": { "enum": ["draft", "approved", "rejected", "release-candidate", "published"] },
            "catalogEligible": { "type": "boolean" }, "indexEligible": { "type": "boolean" }, "premiumEligible": { "type": "boolean" },
            "deploymentEvidence": { "anyOf": [{ "$ref": "#/definitions/deploymentEvidence" }, { "type": "null" }] }
          }
        }
      }
    }
  }
}

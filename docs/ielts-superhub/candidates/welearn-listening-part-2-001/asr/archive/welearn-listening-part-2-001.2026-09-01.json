_ratio": 1.7174721189591078, "no_speech_prob": 0.004275129642337561}, {"id": 49, "seek": 14260, "start": 162.72, "end": 166.72, "text": " That room is now the materials shop, so all borrowed tools must be collected from the", "tokens": [51370, 663, 1808, 307, 586, 264, 5319, 3945, 11, 370, 439, 26805, 3873, 1633, 312, 11087, 490, 264, 51570], "temperature": 0.0, "avg_logprob": -0.18438331351792517, "compression_ratio": 1.7174721189591078, "no_speech_prob": 0.004275129642337561}, {"id": 50, "seek": 14260, "start": 166.72, "end": 168.16, "text": " larger corner room.", "tokens": [51570, 4833, 4538, 1808, 13, 51642], "temperature": 0.0, "avg_logprob": -0.18438331351792517, "compression_ratio": 1.7174721189591078, "no_speech_prob": 0.004275129642337561}, {"id": 51, "seek": 16816, "start": 168.6, "end": 172.79999999999998, "text": " For the textile studio, continue north along the western corridor.", "tokens": [50386, 1171, 264, 42069, 6811, 11, 2354, 6830, 2051, 264, 13231, 25602, 13, 50596], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 52, "seek": 16816, "start": 172.79999999999998, "end": 177.16, "text": " You'll pass the courtyard on your right and eventually reach the toilets in our left corner.", "tokens": [50596, 509, 603, 1320, 264, 41364, 322, 428, 558, 293, 4728, 2524, 264, 37691, 294, 527, 1411, 4538, 13, 50814], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 53, "seek": 16816, "start": 177.16, "end": 180.8, "text": " The textile studio is the room immediately to the right of the toilets.", "tokens": [50814, 440, 42069, 6811, 307, 264, 1808, 4258, 281, 264, 558, 295, 264, 37691, 13, 50996], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 54, "seek": 16816, "start": 180.8, "end": 185.92, "text": " The room farther along the same northern corridor is used for group meetings, not sewing.", "tokens": [50996, 440, 1808, 20344, 2051, 264, 912, 14197, 25602, 307, 1143, 337, 1594, 8410, 11, 406, 19311, 13, 51252], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 55, "seek": 16816, "start": 185.92, "end": 188.72, "text": " The testing bench is on the other side of the building.", "tokens": [51252, 440, 4997, 10638, 307, 322, 264, 661, 1252, 295, 264, 2390, 13, 51392], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 56, "seek": 16816, "start": 188.72, "end": 191.32, "text": " Return to the courtyard and cross to its eastern side.", "tokens": [51392, 24350, 281, 264, 41364, 293, 3278, 281, 1080, 19346, 1252, 13, 51522], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 57, "seek": 16816, "start": 191.32, "end": 195.68, "text": " The glass-fronted room directly opposite the courtyard's western materials shop contains", "tokens": [51522, 440, 4276, 12, 11496, 292, 1808, 3838, 6182, 264, 41364, 311, 13231, 5319, 3945, 8306, 51740], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 58, "seek": 16816, "start": 195.68, "end": 197.2, "text": " the testing equipment.", "tokens": [51740, 264, 4997, 5927, 13, 51816], "temperature": 0.0, "avg_logprob": -0.14370328729802911, "compression_ratio": 1.8823529411764706, "no_speech_prob": 0.0008957678219303489}, {"id": 59, "seek": 19720, "start": 197.2, "end": 200.83999999999997, "text": " This is where a volunteer checks repaired lamps and other low-power electrical items", "tokens": [50364, 639, 307, 689, 257, 13835, 13834, 36551, 34887, 293, 661, 2295, 12, 9513, 12147, 4754, 50546], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 60, "seek": 19720, "start": 200.83999999999997, "end": 202.72, "text": " before they leave the building.", "tokens": [50546, 949, 436, 1856, 264, 2390, 13, 50640], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 61, "seek": 19720, "start": 202.72, "end": 207.48, "text": " Finally, the community kitchen is farther north along the eastern corridor.", "tokens": [50640, 6288, 11, 264, 1768, 6525, 307, 20344, 6830, 2051, 264, 19346, 25602, 13, 50878], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 62, "seek": 19720, "start": 207.48, "end": 210.39999999999998, "text": " Continue past the testing bench towards the top right corner.", "tokens": [50878, 24472, 1791, 264, 4997, 10638, 3030, 264, 1192, 558, 4538, 13, 51024], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 63, "seek": 19720, "start": 210.39999999999998, "end": 213.28, "text": " You'll see the emergency exit marked on their outer wall.", "tokens": [51024, 509, 603, 536, 264, 7473, 11043, 12658, 322, 641, 10847, 2929, 13, 51168], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 64, "seek": 19720, "start": 213.28, "end": 216.72, "text": " The kitchen is the large room immediately to the left of that exit.", "tokens": [51168, 440, 6525, 307, 264, 2416, 1808, 4258, 281, 264, 1411, 295, 300, 11043, 13, 51340], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 65, "seek": 19720, "start": 216.72, "end": 221.51999999999998, "text": " Please keep the exit as self-clear, even when refreshments are being served.", "tokens": [51340, 2555, 1066, 264, 11043, 382, 2698, 12, 43679, 11, 754, 562, 15134, 1117, 366, 885, 7584, 13, 51580], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 66, "seek": 19720, "start": 221.51999999999998, "end": 223.2, "text": " That completes the orientation.", "tokens": [51580, 663, 36362, 264, 14764, 13, 51664], "temperature": 0.0, "avg_logprob": -0.14003862776197828, "compression_ratio": 1.63, "no_speech_prob": 0.00030479577253572643}, {"id": 67, "seek": 22320, "start": 223.2, "end": 227.6, "text": " You may now leave coats in the lockers, take booking questions to the welcome desk, and", "tokens": [50364, 509, 815, 586, 1856, 30036, 294, 264, 4017, 433, 11, 747, 34424, 1651, 281, 264, 2928, 10026, 11, 293, 50584], "temperature": 0.0, "avg_logprob": -0.15867239899105495, "compression_ratio": 1.309090909090909, "no_speech_prob": 0.6244359016418457}, {"id": 68, "seek": 22320, "start": 227.6, "end": 230.72, "text": " wait for the practical tables to open at half past nine.", "tokens": [50584, 1699, 337, 264, 8496, 8020, 281, 1269, 412, 1922, 1791, 4949, 13, 50740], "temperature": 0.0, "avg_logprob": -0.15867239899105495, "compression_ratio": 1.309090909090909, "no_speech_prob": 0.6244359016418457}], "language": "en"}
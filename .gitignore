.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Korean lesson videos/audio — large binaries, excluded from Vercel via .vercelignore
# Keep locally for dev but don't track in git
public/assets/korean/step008/
public/assets/korean/step009/
public/assets/korean/step010/
public/assets/korean/step011/
public/assets/korean/step012/
public/assets/korean/step013/
public/assets/korean/step014/
public/assets/korean/step015/
public/assets/korean/step016/
public/assets/korean/step017/
public/assets/korean/step018/
public/assets/korean/step019/

# Audio de simulacros: TOEFL, IELTS, CILS, CELPE, TOPIK, DELF ahora se COMMITEAN
# (comprimidos a 64k mono, ~248MB) y se sirven directo desde Vercel como estáticos
# en /audio/… El resolver src/lib/examAudio.ts los toma del local si no hay CDN.
# Goethe (aún sin audio) sigue fuera del repo.
public/audio/goethe/
# Práctica escucha alemán/italiano: se COMMITEAN los mp3 finales (listening-NN.mp3
# y it-a1-*.mp3, comprimidos 64k mono). Los archivos fuente sin comprimir NO.
public/audio/aleman/**/De-*.mp3
public/audio/aleman/**/de-prueba.mp3
public/audio/italiano/**/it-a1-*-src.mp3

# Listening A1 (francés, portugués, coreano, japonés, ruso): audio PROVISIONAL de
# scripts/make-placeholder-audio.mjs — pitidos, no voces. Ocupa las rutas y los nombres
# definitivos a propósito, para poder revisar el recorrido antes de gastar créditos.
# Al llegar el audio real: node scripts/make-placeholder-audio.mjs --clean, y entonces
# QUITAR estas cinco líneas para que los mp3 buenos sí se commiteen.

# Comparativas de modelo del piloto de voces (piloto-<idioma>-epNN-<modelo>.mp3).
# Sirven para decidir por oído y se tiran después; el audio bueno se llama listening-NN.mp3.
public/audio/**/piloto-*.mp3
# Artefactos de Playwright: cachés y trazas de las sesiones de prueba, no producto.
/.playwright-cli/
/.playwright-mcp/

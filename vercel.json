{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm exec next build",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "ignoreCommand": "exit 1",
  "git": {
    "deploymentEnabled": {
      "codex/sat-scale-*": false
    }
  },
  "crons": [
    {
      "path": "/api/internal/course-payments/recover",
      "schedule": "17 11 * * *"
    },
    {
      "path": "/api/internal/student-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}

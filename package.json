{
  "name": "idiomaswl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run check:practica-catalog && npm run check:reading-content && npm run audit:writing-curriculum && npm run check:listening-series && npm run check:ielts-task1 && npm run check:ielts-task2 && npm run check:vocabulario && npm run check:historias && npm run check:seo-snippets",
    "dev": "NODE_OPTIONS='--max-old-space-size=3072' next dev",
    "dev:audit": "NODE_OPTIONS='--max-old-space-size=3072' next dev --webpack",
    "dev:safe": "node scripts/safe-dev.js",
    "panic": "node scripts/panic-kill.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:practica-catalog": "node scripts/check-practica-catalog.mjs",
    "check:seo-snippets": "node --experimental-strip-types --no-warnings scripts/check-seo-snippets.mjs",
    "audit:writing-curriculum": "node scripts/audit-writing-curriculum.mjs",
    "audit:dark-mode": "node scripts/audit-dark-mode.mjs",
    "check:reading-content": "node scripts/check-reading-content.mjs",
    "check:listening-series": "node scripts/validate-listening-series.mjs",
    "test:reading": "node --test tests/reading-content.test.mjs",
    "test:icfes": "node --test tests/icfes-scoring.test.mjs",
    "check:icfes-superhub": "node scripts/check-icfes-superhub.mjs && node --experimental-strip-types scripts/audit-icfes-guided-editorial.mjs --no-write && node --experimental-strip-types scripts/audit-icfes-guided-55.mjs --no-write && node --experimental-strip-types scripts/audit-icfes-official-guided.mjs --no-write && node --experimental-strip-types scripts/audit-icfes-seo-product.mjs --no-write && node --experimental-strip-types scripts/audit-icfes-100-users.mjs --no-write",
    "audit:icfes-guided": "node --experimental-strip-types scripts/audit-icfes-guided-editorial.mjs",
    "audit:icfes-guided-55": "node --experimental-strip-types scripts/audit-icfes-guided-55.mjs",
    "audit:icfes-official-guided": "node --experimental-strip-types scripts/audit-icfes-official-guided.mjs",
    "audit:icfes-seo-product": "node --experimental-strip-types scripts/audit-icfes-seo-product.mjs",
    "audit:icfes-100-users": "node --experimental-strip-types scripts/audit-icfes-100-users.mjs",
    "audit:icfes-100-users:runtime": "node --experimental-strip-types scripts/audit-icfes-100-users.mjs --runtime",
    "audit:icfes-runtime": "node --experimental-strip-types scripts/audit-icfes-runtime-smoke.mjs",
    "audit:icfes-final": "node scripts/audit-icfes-final.mjs",
    "audit:icfes-inventory": "node --experimental-strip-types scripts/audit-icfes-inventory.mjs",
    "check:exam-practice-content": "node scripts/check-exam-practice-content.mjs",
    "check:ielts-task2": "node scripts/check-ielts-task2-alignment.mjs",
    "audit:ielts": "node scripts/audit-ielts-routes.mjs",
    "clean": "rm -rf .next .turbo node_modules/.cache && echo '✓ Cache limpiado'",
    "audit:listening-audio": "node scripts/audit-listening-audio.mjs",
    "test:e2e": "playwright test",
    "check:vocabulario": "node scripts/check-vocabulario.mjs",
    "check:ielts-task1": "node scripts/check-ielts-task1-alignment.mjs",
    "check:historias": "node scripts/check-historias.mjs",
    "audit:historias-tts": "node scripts/audit-historias-tts.mjs",
    "audio:historias": "node scripts/generate-historias-audio.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@wavesurfer/react": "^1.0.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^12.38.0",
    "hangul-js": "^0.2.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^1.2.0",
    "tailwind-merge": "^2.2.0",
    "wavesurfer.js": "^7.12.7",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }

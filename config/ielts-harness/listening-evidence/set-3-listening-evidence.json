      "academicEvidenceSha256": "f8206f7b4e2e97d484801571221118ad1bd1de64deaa8acf76bcef288faf2c9d",
      "academicExcerptSha256": "4b14368ee326e306f9c6f41b83aa1b4b9aae923cf4f88a44595d7e07210b4994",
      "startSeconds": 1424.14,
      "endSeconds": 1436.98,
      "audiblePhrase": "Originally pictographic, that is based on simple pictures representing objects, cuneiform evolved over centuries into a more abstract system of wedge shaped marks pressed into clay tablets with a reed stylus.",
      "audiblePhraseSha256": "396dd7cafb6f6e9222db8175582bb7384fdf64419822c7f10c49a106bb32a35d",

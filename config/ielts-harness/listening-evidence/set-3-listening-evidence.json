    {
      "question": 22,
      "responseKey": "l3q22",
      "part": 3,
      "academicEvidenceSha256": "bc3d91e65f6a06c61426ccdbc4234fbd9422d4aa69e1c085c82fede7243d763e",
      "academicExcerptSha256": "c9fe435cbcc594af553c8f7f9165ef0378b28458520b6a8f55a47b6402791bc1",
      "startSeconds": 1049.34,
      "endSeconds": 1064.36,
      "audiblePhrase": "I'd add that there's also a social dimension. Community gardens can help build relationships between neighbours who might otherwise never interact. There's evidence that social cohesion in areas with active community gardens is significantly higher.",
      "audiblePhraseSha256": "abcd8a31d7ef4605b4f3fa11600773eda5f162ee10c349341a88703e4b6e72a1",
      "rationale": "The timed ASR window reproduces the academic review excerpt that supports the keyed selection and dismisses its distractors.",
      "method": "ACADEMIC_EXCERPT_ALIGNMENT",
      "confidence": "HIGH",
      "alignmentScore": 0.9722,
      "answerSupportScore": 1,
      "sourceAsr": {
        "path": "config/ielts-harness/listening-evidence/sources/set-3/12f92debcaff-whisper-set-3.json",
        "sha256": "12f92debcaff6b57210a3a996f9f51036586d37fe75462496dd5dd9a22ecc71e",
        "startSeconds": 1049.34,
        "endSeconds": 1064.36
      }

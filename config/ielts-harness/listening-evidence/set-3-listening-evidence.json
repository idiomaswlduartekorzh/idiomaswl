    {
      "question": 21,
      "responseKey": "l3q21",
      "part": 3,
      "academicEvidenceSha256": "2da661ab559c11989f05458bae808d062210f85fc5365f7753e390acdb9cdc7a",
      "academicExcerptSha256": "9ea6b478f22082c7043809e0b685e4236893a64337cf515498cf427b64b5185b",
      "startSeconds": 992.64,
      "endSeconds": 1007.58,
      "audiblePhrase": "Yes. What struck me most was the potential for urban farming to address food security issues in cities. If residents can grow some of their own produce, that reduces dependence on supply chains that can be disrupted.",
      "audiblePhraseSha256": "d303655e3bc621ef6b70a3613b5ac6c339ecde3a83a604a0b585c46c81dd74f8",
      "rationale": "The timed ASR window reproduces the academic review excerpt that supports the keyed selection and dismisses its distractors.",

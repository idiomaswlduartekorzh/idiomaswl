      "startSeconds": 1415.02,
      "endSeconds": 1423.12,
      "audiblePhrase": "The earliest known writing system is cuneiform, developed by the Sumerians of ancient Mesopotamia around 3200 BCE.",
      "audiblePhraseSha256": "50ff87b7d3c367d603534b072b97e6b1f7578ee8a13fa0f8075a37d3bdc118d8",
      "rationale": "The academic review identifies the answer evidence, and the ASR exact match locates that supporting phrase in the published recording.",

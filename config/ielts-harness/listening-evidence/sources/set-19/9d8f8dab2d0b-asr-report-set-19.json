      "matchKind": "exact",
      "diagnosticStartSeconds": null,
      "startSeconds": 1483.18,
      "endSeconds": 1491.48,
      "audiblePhrase": "A much older method is pumped hydro. When there is spare electricity, it is used to pump water uphill into a reservoir."
    },
    {
      "question": 35,
      "responseKey": "l4-form__35",
      "candidateAcceptedAnswers": [

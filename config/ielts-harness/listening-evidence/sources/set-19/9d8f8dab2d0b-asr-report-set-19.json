      "matchKind": "exact",
      "diagnosticStartSeconds": null,
      "startSeconds": 1525.66,
      "endSeconds": 1534.96,
      "audiblePhrase": "In compressed air storage, surplus electricity squeezes air into sealed underground caves. When demand rises, the air is let out to drive a generator."
    },
    {
      "question": 37,
      "responseKey": "l4-form__37",
      "candidateAcceptedAnswers": [

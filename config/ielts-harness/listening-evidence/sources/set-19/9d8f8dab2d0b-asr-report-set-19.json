      "matchKind": "exact",
      "diagnosticStartSeconds": null,
      "startSeconds": 1492.62,
      "endSeconds": 1500.36,
      "audiblePhrase": "Later, when power is needed, that water is released and flows back down through a turbine, which spins to generate electricity all over again."
    },
    {
      "question": 36,
      "responseKey": "l4-form__36",
      "candidateAcceptedAnswers": [

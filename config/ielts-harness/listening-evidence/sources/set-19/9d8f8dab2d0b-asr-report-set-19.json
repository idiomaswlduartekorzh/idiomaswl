      "matchKind": "exact",
      "diagnosticStartSeconds": null,
      "startSeconds": 1435.78,
      "endSeconds": 1447.38,
      "audiblePhrase": "Because supply and use rarely match, we need to capture surplus power and release it later, during periods of high demand. For instance, on a cold winter evening when everyone switches on the heating."
    },
    {
      "question": 33,
      "responseKey": "l4-form__33",

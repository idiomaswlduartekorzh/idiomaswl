{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.idiomaswl.com/schemas/icfes-collegiate-review-v2.json",
  "type": "object",
  "required": ["reportId", "workOrderId", "workOrderDigest", "candidateId", "candidateDigest", "role", "actor", "generatedAt", "verdict", "checks", "findings"],
  "properties": {
    "reportId": { "type": "string", "minLength": 1 },
    "workOrderId": { "const": "icfes-final-integration-v2" },
    "workOrderDigest": { "$ref": "#/$defs/hash" },
    "candidateId": { "const": "icfes-final-integration-20260912" },
    "candidateDigest": { "$ref": "#/$defs/hash" },
    "role": { "enum": ["english-specialist", "icfes-format-specialist", "editorial-adjudicator"] },
    "actor": {
      "type": "object",
      "required": ["actorId", "actorType"],
      "properties": {
        "actorId": { "type": "string", "minLength": 2 },
        "actorType": { "const": "agent" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["PASS", "BLOCKED"] },
    "checks": { "type": "array", "minItems": 1 },
    "findings": { "type": "array" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

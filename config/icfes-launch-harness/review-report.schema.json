{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.idiomaswl.com/schemas/icfes-launch-review-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "workOrderId", "workOrderDigest", "candidateId", "candidateDigest", "role", "actor", "verdict", "generatedAt", "checks", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "minLength": 1 },
    "workOrderId": { "type": "string", "minLength": 1 },
    "workOrderDigest": { "$ref": "#/$defs/hash" },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateDigest": { "$ref": "#/$defs/hash" },
    "role": { "type": "string", "minLength": 1 },
    "actor": { "$ref": "#/$defs/actor" },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "actorType"],
      "properties": {
        "actorId": { "type": "string", "minLength": 2 },
        "actorType": { "enum": ["agent", "human"] },
        "modelOrCredential": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "questionId", "currentKey", "proposedKeyOrWording", "evidence", "severity", "confidence", "blockProduction"],
      "properties": {
        "resourceId": { "type": "string", "minLength": 1 },
        "questionId": { "type": ["string", "null"] },
        "currentKey": { "type": ["string", "null"] },
        "proposedKeyOrWording": { "type": ["string", "null"] },
        "evidence": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "blockProduction": { "type": "boolean" }
      }
    }
  }
}

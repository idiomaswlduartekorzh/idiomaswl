{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.idiomaswl.com/schemas/icfes-launch-release-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "note": { "type": "string" },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["releaseId", "candidateId", "candidateDigest", "workOrderId", "workOrderDigest", "approvalIds", "releasedAt", "releaseWardenActorId"],
        "properties": {
          "releaseId": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "candidateDigest": { "$ref": "#/$defs/hash" },
          "workOrderId": { "type": "string", "minLength": 1 },
          "workOrderDigest": { "$ref": "#/$defs/hash" },
          "approvalIds": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
          "releasedAt": { "type": "string", "format": "date-time" },
          "releaseWardenActorId": { "type": "string", "minLength": 2 }
        }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}

            { "path": "src/lib/icfes/teacher-ops-v1.ts", "lines": "4-21,48-81,99-133,150-235", "claim": "The local pure harness fixes one credit, a conditional 24-hour target, pre-checkout reservation, capacity stop conditions, request idempotency, queue leases and 12/18/22-hour alerts." },
            { "path": "supabase/migrations/20260909000500_xpress_memberships_wompi.sql", "lines": "121-280,283-396,425-482,616-733", "claim": "The unapplied migration models a service-role-only calibrated roster, atomic reservation, one review per membership, payment consumption, queue leases and alerts; ICFES requests require an owned nonempty icfes_attempts row and the leased payload projects that real answer source without identity." },
            { "path": "src/lib/icfes/teacher-ops.server.ts", "lines": "38-78", "claim": "Server-only helpers enqueue an attempt-bound review and read its payload through the lease/reviewer-checked RPC; no browser route or worker currently invokes them." },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.idiomaswl.com/schemas/icfes-launch-approvals-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvals"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "note": { "type": "string" },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approvalId", "workOrderId", "workOrderDigest", "candidateId", "candidateDigest", "role", "actor", "decision", "approvedAt", "evidence"],
        "properties": {
          "approvalId": { "type": "string", "minLength": 1 },
          "workOrderId": { "type": "string", "minLength": 1 },
          "workOrderDigest": { "$ref": "#/$defs/hash" },
          "candidateId": { "type": "string", "minLength": 1 },
          "candidateDigest": { "$ref": "#/$defs/hash" },
          "role": { "type": "string", "minLength": 1 },
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actorId", "actorType"],
            "properties": {
              "actorId": { "type": "string", "minLength": 2 },
              "actorType": { "const": "human" },
              "credential": { "type": "string", "minLength": 1 }
            }
          },
          "decision": { "enum": ["APPROVE", "REJECT"] },
          "approvedAt": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}

# Wompi Colombia
# Usa credenciales test en local/Preview y credenciales prod solo en Production.
# La llave publica puede exponerse al navegador; las demas son secretos de servidor.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Informe detallado TOEFL. Mantener apagado hasta aprobar Sandbox, precio y SLA.
TOEFL_REPORT_PAYWALL_ENABLED=false
TOEFL_REPORT_PRICE_COP=
TOEFL_SPEAKING_REVIEW_SLA_HOURS=48
# Opcional para previews; por defecto usa https://www.idiomaswl.com.
TOEFL_REPORT_ORIGIN=

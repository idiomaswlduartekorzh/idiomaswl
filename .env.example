# Wompi Colombia
# Usa credenciales test en local/Preview y credenciales prod solo en Production.
# La llave publica puede exponerse al navegador; las demas son secretos de servidor.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
CRON_SECRET=

# ICFES: secure server grading works when this secret is set (32+ random chars in production).
# The commercial layer stays off unless BOTH persistence and Pase flags are true.
ICFES_ATTEMPT_SIGNING_SECRET=
ICFES_PERSISTENCE_ENABLED=false
ICFES_PASE_ENABLED=false
ICFES_ADVERSARIAL_PAYMENTS_ENABLED=false
ICFES_PASE_PRICE_COP=12000
# Local/Preview may use http://localhost:3000. Production must use HTTPS.
ICFES_PASE_ORIGIN=

# Informe detallado TOEFL. Mantener apagado hasta aprobar Sandbox, precio y SLA.
TOEFL_REPORT_PAYWALL_ENABLED=false
TOEFL_REPORT_PRICE_COP=
TOEFL_SPEAKING_REVIEW_SLA_HOURS=48
# Opcional para previews; por defecto usa https://www.idiomaswl.com.
TOEFL_REPORT_ORIGIN=

# Four-week class catalog. Keep disabled until the legal text, database migration,
# Wompi sandbox flow and operating procedures have been verified.
COURSE_PRICING_ENABLED=false
# Emergency kill switch. The launch itself is versioned in src/lib/course-pricing/release.ts.
COURSE_SALES_EMERGENCY_DISABLED=false
# Local visual preview only; never enables a charge.
COURSE_PRICING_PREVIEW=false
# At least 32 random characters; signs the private browser receipt used before the account exists.
COURSE_ORDER_ACCESS_SECRET=
# Transactional email. RESEND_API_KEY stays server-side.
RESEND_API_KEY=
COURSE_FROM_EMAIL="WeLearn <bienvenida@idiomaswl.com>"
COURSE_OWNER_NOTIFICATION_EMAIL=david_duarte182@hotmail.com

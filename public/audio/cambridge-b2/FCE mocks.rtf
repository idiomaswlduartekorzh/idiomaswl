\f0\b \cb3 \'a0\'a0\'a0\'a0\'a0 B 
\f1\b0 \'a0\'a0finding time for leisure activities after school.\cb1 \

\f0\b \cb3 \'a0\'a0\'a0\'a0\'a0 C 
\f1\b0 \'a0\'a0making himself run in cold weather before school.\cb1 \
\

\f0\b \cb3 27 
